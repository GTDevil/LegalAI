{
  "name": "LegalAI",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "install": "./.cursor/scripts/install.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd /workspace && .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
      "description": "FastAPI development server for the Loan Settlement Agent API on port 8000"
    }
  ],
  "ports": [
    {
      "name": "api",
      "port": 8000
    }
  ]
}
